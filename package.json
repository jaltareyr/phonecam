{
  "name": "phonecam",
  "version": "0.7.0",
  "description": "Open-source Android webcam for Windows with local WebRTC video over Wi-Fi or USB.",
  "license": "MIT",
  "author": "Yashodhan Jaltare",
  "repository": { "type": "git", "url": "https://github.com/jaltareyr/phonecam.git" },
  "homepage": "https://github.com/jaltareyr/phonecam#readme",
  "bugs": { "url": "https://github.com/jaltareyr/phonecam/issues" },
  "keywords": ["android", "webcam", "windows", "webrtc", "virtual-camera", "wifi", "usb", "open-source"],
  "engines": { "node": ">=22.12.0" },
  "overrides": { "global-agent": "4.1.3" },
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "package:win": "node scripts/package-desktop.mjs",
    "portable:win": "node scripts/build-portable.mjs",
    "installer:win": "node scripts/build-installer.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  }
}
